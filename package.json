{
  "name": "activityreel",
  "displayName": "ActivityReel",
  "description": "See every change in your workspace, live: diffs, saves, tasks and terminal commands. Local, private.",
  "version": "0.1.0",
  "publisher": "smh-dev-ai",
  "license": "MIT",
  "author": {
    "name": "Seyed Mehdi Hosseini",
    "email": "dev.smh.ai@gmail.com",
    "url": "https://github.com/SMH-AI-Dev/"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "live",
    "diff",
    "activity",
    "timeline",
    "changes",
    "edits",
    "history",
    "watch",
    "workspace",
    "file changes",
    "file watcher",
    "developer tools",
    "productivity",
    "observability",
    "local",
    "privacy",
    "persian",
    "rtl",
    "visualization",
    "diff viewer",
    "code review",
    "audit",
    "tasks",
    "debug",
    "terminal"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/SMH-AI-Dev/ActivityReel.git"
  },
  "bugs": {
    "url": "https://github.com/SMH-AI-Dev/ActivityReel/issues"
  },
  "homepage": "https://github.com/SMH-AI-Dev/ActivityReel#readme",
  "qna": "marketplace",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:activityreel.panel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "activityreel.open",
        "title": "Open Live Activity",
        "category": "ActivityReel",
        "icon": "$(open-preview)"
      },
      {
        "command": "activityreel.togglePause",
        "title": "Pause / Resume Tracking",
        "category": "ActivityReel",
        "icon": "$(debug-pause)"
      },
      {
        "command": "activityreel.clear",
        "title": "Clear Activity",
        "category": "ActivityReel",
        "icon": "$(clear-all)"
      },
      {
        "command": "activityreel.exportJson",
        "title": "Export Activity as JSON",
        "category": "ActivityReel"
      },
      {
        "command": "activityreel.exportMarkdown",
        "title": "Export Activity as Markdown",
        "category": "ActivityReel"
      },
      {
        "command": "activityreel.about",
        "title": "About ActivityReel",
        "category": "ActivityReel",
        "icon": "$(info)"
      }
    ],
    "keybindings": [
      {
        "command": "activityreel.open",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "activityreel",
          "title": "ActivityReel",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "activityreel": [
        {
          "type": "webview",
          "id": "activityreel.feed",
          "name": "Live activity"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "activityreel.togglePause",
          "when": "view == activityreel.feed",
          "group": "navigation@1"
        },
        {
          "command": "activityreel.clear",
          "when": "view == activityreel.feed",
          "group": "navigation@2"
        },
        {
          "command": "activityreel.open",
          "when": "view == activityreel.feed",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "activityreel.togglePause",
          "when": "activityreel.enabled"
        },
        {
          "command": "activityreel.clear",
          "when": "activityreel.enabled"
        },
        {
          "command": "activityreel.exportJson",
          "when": "activityreel.enabled"
        },
        {
          "command": "activityreel.exportMarkdown",
          "when": "activityreel.enabled"
        }
      ]
    },
    "configuration": {
      "title": "ActivityReel",
      "properties": {
        "activityreel.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Track activity in this window. Disabling stops all tracking; the existing history stays readable."
        },
        "activityreel.maxEvents": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 5000,
          "scope": "window",
          "markdownDescription": "Maximum number of events kept in memory and history. Diffs are retained for the newest 300 events."
        },
        "activityreel.maxDiffLines": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "scope": "window",
          "markdownDescription": "Maximum number of diff lines stored per change."
        },
        "activityreel.contextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "scope": "window",
          "markdownDescription": "Unchanged context lines shown around each diff hunk."
        },
        "activityreel.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 2000,
          "scope": "window",
          "markdownDescription": "Idle time before a burst of edits becomes one event. Continuous bursts are flushed after 1.5 seconds."
        },
        "activityreel.persistHistory": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Keep activity history in workspace storage between sessions. All data stays local."
        },
        "activityreel.trackFileOperations": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show file create, delete, rename and external change events."
        },
        "activityreel.trackExternalChanges": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show on-disk changes made outside the editor (watcher events)."
        },
        "activityreel.trackTasks": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show task start, finish and exit status."
        },
        "activityreel.trackDebug": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show debug session start and end."
        },
        "activityreel.trackTerminal": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Show terminal commands when shell integration is available. Command text may contain secrets; it is stored locally only."
        },
        "activityreel.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**",
            "**/.next/**",
            "**/coverage/**"
          ],
          "scope": "resource",
          "markdownDescription": "Glob patterns excluded from file and edit tracking."
        },
        "activityreel.maxFileSizeKB": {
          "type": "number",
          "default": 2048,
          "minimum": 64,
          "maximum": 65536,
          "scope": "window",
          "markdownDescription": "Documents larger than this are not diffed."
        },
        "activityreel.statusBar": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show the ActivityReel status bar item."
        },
        "activityreel.locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "fa"
          ],
          "enumDescriptions": [
            "Follow the VS Code display language.",
            "English (LTR).",
            "فارسی (RTL)."
          ],
          "default": "auto",
          "scope": "window",
          "description": "Language used by the ActivityReel interface."
        },
        "activityreel.openFilesOutsideWorkspace": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Also track edits in files outside the workspace (file name only)."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','media/webview','out','.vscode-test'])fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "dev:webview": "vite --config vite.config.mts",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/integration.mjs",
    "icon": "node scripts/make-icon.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "vscode:prepublish": "npm run build",
    "package": "npm run check && vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "minimatch": "^11.0.9",
    "mocha": "^12.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
